{
  "name": "action-assign-milestone",
  "version": "3.0.0",
  "description": "GitHub action to assign a milestone to issues",
  "type": "module",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write **/*.ts",
    "format-check": "prettier --check **/*.ts",
    "lint": "eslint .",
    "package": "ncc build src/main.ts --source-map --license licenses.txt",
    "all": "npm run build && npm run format && npm run lint && npm run package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoispag/action-assign-milestone.git"
  },
  "keywords": [
    "Actions",
    "GitHub",
    "Milestone"
  ],
  "author": "zoispag",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@vercel/ncc": "^0.38.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-github": "^6.0.0",
    "js-yaml": "^4.1.0",
    "prettier": "^3.9.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.0"
  }
}
